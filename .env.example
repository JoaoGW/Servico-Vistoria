# Configuração usada pelo Docker Compose. Copie este arquivo para .env e preencha
# os valores vazios antes de iniciar os serviços.
POSTGRES_DB=vistoria
POSTGRES_USER=vistoria
POSTGRES_PASSWORD=

# Use o hostname "postgres" na URL, pois a API roda dentro da rede Docker.
# Exemplo de formato: postgresql://usuario:senha@postgres:5432/banco
DATABASE_URL=
JWT_SECRET=

# Portas publicadas na máquina host.
API_PORT=3001
WEB_PORT=3000

# Opcional. A configuração padrão já conecta o portal à API no Docker.
# APIS_URL=http://api:3001
