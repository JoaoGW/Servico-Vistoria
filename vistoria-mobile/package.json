{
  "name": "vistoria-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.15",
    "@gluestack-ui/core": "^3.0.25",
    "@gluestack-ui/utils": "^3.0.21",
    "@nozbe/simdjson": "^3.9.4",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-location": "^57.0.15",
    "expo-network": "^57.0.1",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^1.39.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-leaflet-view": "^1.1.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-variants": "^0.1.20",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --dev-client --android",
    "run:android": "expo run:android",
    "build:android:local": "set -a && . ./.env.local && set +a && ANDROID_HOME=\"/Users/multscantec/Library/Android/sdk\" ANDROID_SDK_ROOT=\"/Users/multscantec/Library/Android/sdk\" eas build --platform android --local --non-interactive",
    "build:android:local:development": "set -a && . ./.env.local && set +a && ANDROID_HOME=\"/Users/multscantec/Library/Android/sdk\" ANDROID_SDK_ROOT=\"/Users/multscantec/Library/Android/sdk\" eas build --platform android --profile development --local --non-interactive",
    "build:android:local:apk": "set -a && . ./.env.local && set +a && ANDROID_HOME=\"/Users/multscantec/Library/Android/sdk\" ANDROID_SDK_ROOT=\"/Users/multscantec/Library/Android/sdk\" eas build --platform android --profile production-apk --local --non-interactive",
    "build:android:cloud": "eas build --platform android",
    "ios": "expo run:ios --device",
    "build:ios:local": "set -a && . ./.env.local && set +a && PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:${PATH}\" eas build --platform ios --local",
    "build:ios:local:development": "set -a && . ./.env.local && set +a && PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:${PATH}\" eas build --platform ios --local --profile development",
    "build:ios:cloud": "eas build --platform ios",
    "lint": "expo lint"
  },
  "private": true
}
